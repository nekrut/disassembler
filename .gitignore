# Rust build artifacts
/walker/target/
**/*.rs.bk

# Python
__pycache__/
*.pyc
.venv/
.condaenv-walker/

# Walker outputs / scratch
# The default --scratch-dir is /dev/shm/logan-walker, outside the work tree, so it needs no rule.
*.gaf
reconstructed.fasta
reconstructed_haplotypes.fasta
alt_haplotypes.fasta
bubbles.json
*_walker_summary.json
# default -o for logan-walker, and the out dirs used by the README examples
/walker_output/
/out/
/msa/
/candidates/

# Large streamed data (regenerate from S3)
*.unitigs.fa
*.unitigs.fa.zst

# Editor / OS
.vscode/
.DS_Store
*.log
nohup.out

# kmer-diversity-sieve build artifacts (built from the submodule source)
extern/kmer-diversity-sieve/l1_pipeline_serial
extern/kmer-diversity-sieve/l1_pipeline_threads
extern/kmer-diversity-sieve/l1_pipeline
tests/*.rank*.fasta
