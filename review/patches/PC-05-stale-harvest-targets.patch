diff --git a/src/disassembler/cmd/harvest.py b/src/disassembler/cmd/harvest.py
index a384857a04e9..000000000000 100644
--- a/src/disassembler/cmd/harvest.py
+++ b/src/disassembler/cmd/harvest.py
@@ -174,6 +174,17 @@ def _write_outputs(per_target, out_dir, n_items, n_failed, n_empty, n_bad_target
     `failure_noun` is just a label for the human-facing message so the local-files
     path can say "shard files" instead of "shards" without duplicating the block.
     """
+    # Drop the per-target files of an earlier harvest into this directory whose targets this
+    # one lacks, so neither from-kmindex nor stratify's directory scan can pick them up.
+    try:
+        previous = json.loads((out_dir / "summary.json").read_text())
+    except (OSError, ValueError):
+        previous = {}
+    for old in (previous if isinstance(previous, dict) else {}):
+        if old != "_union" and old not in per_target and safe_target_name(old) == old:
+            for suffix in (".accessions.txt", ".scores.json"):
+                (out_dir / f"{old}{suffix}").unlink(missing_ok=True)
+
     all_union = set()
     summary = {}
     for target, acc_dict in sorted(per_target.items()):
diff --git a/src/disassembler/cmd/pipe_from_kmindex.py b/src/disassembler/cmd/pipe_from_kmindex.py
index 623dfc862f08..000000000000 100644
--- a/src/disassembler/cmd/pipe_from_kmindex.py
+++ b/src/disassembler/cmd/pipe_from_kmindex.py
@@ -17,6 +17,7 @@ Accession-list selection after stratify:
 from __future__ import annotations
 
 import argparse
+import json
 import sys
 from pathlib import Path
 
@@ -319,11 +320,27 @@ def run(args) -> int:
         if rc != 0:
             return rc
 
+        # The cohort directory may hold an earlier harvest's per-target files, so the
+        # target must be one this harvest produced (its summary.json was just rewritten).
+        summary_file = cohort_dir / "summary.json"
+        try:
+            harvested = {t for t in json.loads(summary_file.read_text()) if t != "_union"}
+        except (OSError, ValueError) as e:
+            print(f"from-kmindex: cannot read {summary_file}: {e}", file=sys.stderr)
+            return 1
+        if args.target not in harvested:
+            print(f"from-kmindex: target {args.target!r} has no hits in the harvest in "
+                  f"{cohort_dir} (targets: {', '.join(sorted(harvested)) or 'none'})",
+                  file=sys.stderr)
+            return 1
+
     # ---- 2/3 stratify (optional) ------------------------------------------
     if args.score_bins:
         stratify_ns = stage_args(
             stratify_cmd,
             out_dir=str(cohort_dir),
+            # After a fresh harvest, its own score file; under --skip-harvest, found by content.
+            scores=None if args.skip_harvest else [str(cohort_dir / f"{args.target}.scores.json")],
             target=args.target,
             score_bins=args.score_bins,
         )
