+    def _walker_exiting(self, code):
+        w = self.work / f"walker_exit_{code}.sh"
+        w.write_text(f"#!/usr/bin/env bash\necho \"$@\" > \"$(dirname \"$0\")/walker_argv.txt\"\n"
+                     f"fasta=''; while [ $# -gt 0 ]; do [ \"$1\" = -f ] && fasta=\"$2\"; shift; done\n"
+                     f": > \"$fasta\"; exit {code}\n")
+        w.chmod(0o755)
+        return w
+
+    def test_an_all_errored_walker_keeps_exit_3(self):
+        rc, log = _run(["reconstruct", "-a", "SRR1", "-q", str(self.ref), "-o",
+                        str(self.work / "out"), "--walker-bin", str(self._walker_exiting(3))])
+        self.assertEqual(rc, 3, log)
+
+    def test_allow_empty_accepts_nothing_found(self):
+        out = self.work / "out"
+        out.mkdir()
+        stale = [out / "gene_codon_msa.fasta", out / "gene_fasttree.nwk",
+                 out / "reconstructed.sieved.fasta"]
+        for p in stale:
+            p.write_text(">old\n")
+        argv = ["reconstruct", "-a", "SRR1", "-q", str(self.ref), "-o", str(out),
+                "--walker-bin", str(self._walker_exiting(0))]
+        rc, log = _run(argv)
+        self.assertEqual(rc, 1, log)
+        rc, log = _run(argv + ["--allow-empty"])
+        self.assertEqual(rc, 0, log)
+        self.assertIn("--allow-empty", self.walker_argv())
+        self.assertEqual([p.name for p in stale if p.exists()], [])
+        rc, log = _run(argv + ["--", "--allow-empty"])
+        self.assertEqual(rc, 0, log)
+        self.assertEqual(self.walker_argv().count("--allow-empty"), 1)
+
