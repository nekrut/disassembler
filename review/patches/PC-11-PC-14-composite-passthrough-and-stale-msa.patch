+DERIVED_MANIFEST = ".disassembler_derived"
+
+
+def clear_derived(out: Path) -> None:
+    """Remove the MSA/tree an earlier composite run recorded in `out`, then the record."""
+    m = out / DERIVED_MANIFEST
+    try:
+        names = m.read_text().split("\n")
+    except FileNotFoundError:
+        return
+    for name in names:
+        # Bare file names only: the manifest must not reach outside --out-dir.
+        if name and Path(name).name == name and name not in (".", ".."):
+            (out / name).unlink(missing_ok=True)
+    m.unlink(missing_ok=True)
+
+
+def record_derived(out: Path, *paths: Path) -> None:
+    (out / DERIVED_MANIFEST).write_text("".join(f"{p.name}\n" for p in paths))
 
 
