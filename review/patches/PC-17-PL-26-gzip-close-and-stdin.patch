+class _GzipReader(gzip.GzipFile):
+    """GzipFile that reports truncated or corrupt data as OSError and, when it owns its
+    source (open_text), closes that source too."""
+
+    def __init__(self, fileobj, owns=False):
+        super().__init__(fileobj=fileobj, mode="rb")
+        self._owned = fileobj if owns else None
+
+    def _wrap(self, fn, *a):
+        try:
+            return fn(*a)
+        except (EOFError, zlib.error) as e:
+            raise OSError(f"truncated or corrupt gzip data ({e})") from None
+
+    def read(self, size=-1):
+        return self._wrap(super().read, size)
+
+    def read1(self, size=-1):
+        return self._wrap(super().read1, size)
+
+    def readinto(self, b):
+        return self._wrap(super().readinto, b)
+
+    def close(self):
+        try:
+            super().close()
+        finally:
+            if self._owned is not None:
+                self._owned.close()
+
+
+def text_stream(raw, owns=False) -> io.TextIOWrapper:
     """UTF-8 text from a binary stream, gunzipped when it starts with the gzip magic bytes.
     A stream without `peek` (an HTTP body) is buffered first."""
     buf = raw if hasattr(raw, "peek") else io.BufferedReader(raw)
