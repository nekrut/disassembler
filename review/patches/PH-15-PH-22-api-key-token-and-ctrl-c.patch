     return None
+
+
+def check_api_key(key: str, source: str) -> str:
+    """`key` stripped, or ValueError if it cannot be one HTTP header token. The message
+    never contains the value: the HTTP libraries quote the whole header value in their
+    own errors, which then reached stderr (a Galaxy job log, a CI log)."""
+    key = key.strip()
+    if not key:
+        raise ValueError(f"the Galaxy API key from {source} is empty")
+    if any(c.isspace() or not c.isprintable() for c in key):
+        n = len(key.splitlines())
+        raise ValueError(f"the Galaxy API key from {source} is not a single token "
+                         f"({n} line(s), or whitespace/control characters inside); "
+                         f"the value is not shown")
+    return key
