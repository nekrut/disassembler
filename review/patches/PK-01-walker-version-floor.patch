diff --git a/tests/test_walker_version.py b/tests/test_walker_version.py
new file mode 100644
--- /dev/null
+++ b/tests/test_walker_version.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""The walker passthrough and the composites refuse a logan-walker outside the supported range."""
+
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+def _fake(dirpath: Path, version_line: str) -> Path:
+    exe = dirpath / "logan-walker"
+    exe.write_text("#!/usr/bin/env bash\n"
+                   f'[ "$1" = --version ] && {{ echo "{version_line}"; exit 0; }}\n'
+                   'echo ran "$@"\n')
+    exe.chmod(0o755)
+    return exe
+
+
+def _cli(*argv, env=None):
+    return subprocess.run([sys.executable, "-m", "disassembler", *argv],
+                          capture_output=True, text=True, env=env)
+
+
+class TestWalkerVersionGuard(unittest.TestCase):
+    def setUp(self):
+        self.work = Path(tempfile.mkdtemp())
+        self.env = {k: v for k, v in os.environ.items() if k != "DISASSEMBLER_ANY_WALKER"}
+
+    def tearDown(self):
+        shutil.rmtree(self.work, ignore_errors=True)
+
+    def test_an_older_walker_is_refused(self):
+        w = _fake(self.work, "logan-walker 0.1.0")
+        r = _cli("walker", "--walker-bin", str(w), "--version", env=self.env)
+        self.assertEqual(r.returncode, 2)
+        self.assertIn("needs logan-walker >=0.1.1,<0.2", r.stderr)
+        self.assertEqual(r.stdout, "")
+
+    def test_a_next_minor_walker_is_refused(self):
+        w = _fake(self.work, "logan-walker 0.2.0")
+        self.assertEqual(_cli("walker", "--walker-bin", str(w), "-a", "X",
+                              env=self.env).returncode, 2)
+
+    def test_a_supported_walker_runs(self):
+        for v in ("0.1.1", "0.1.7"):
+            w = _fake(self.work, f"logan-walker {v}")
+            r = _cli("walker", "--walker-bin", str(w), "-a", "X", env=self.env)
+            self.assertEqual((r.returncode, r.stdout.strip()), (0, "ran -a X"))
+
+    def test_a_binary_without_a_version_is_let_through(self):
+        w = _fake(self.work, "something else")
+        self.assertEqual(_cli("walker", "--walker-bin", str(w), "-a", "X",
+                              env=self.env).returncode, 0)
+
+    def test_the_override_lets_an_old_walker_run(self):
+        w = _fake(self.work, "logan-walker 0.1.0")
+        env = dict(self.env, DISASSEMBLER_ANY_WALKER="1")
+        self.assertEqual(_cli("walker", "--walker-bin", str(w), "-a", "X",
+                              env=env).returncode, 0)
+
+    def test_reconstruct_refuses_an_old_walker_before_any_stage(self):
+        w = _fake(self.work, "logan-walker 0.1.0")
+        ref = self.work / "gene.fa"
+        ref.write_text(">gene\nATGAAATAA\n")
+        out = self.work / "out"
+        r = _cli("reconstruct", "-q", str(ref), "-a", "SRR1", "-o", str(out), "--skip-tree",
+                 "--walker-bin", str(w), env=self.env)
+        self.assertEqual(r.returncode, 1, r.stderr)
+        self.assertIn("is logan-walker 0.1.0", r.stderr)
+        self.assertNotIn("1/2 walker", r.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
