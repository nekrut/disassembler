+# The walker versions this disassembler release works with: the same range as the recipe's
+# `logan-walker >=0.1.1,<0.2`. Raise the floor with every walker release that ships with it.
+WALKER_MIN = (0, 1, 1)
+WALKER_BELOW = (0, 2, 0)
+
+
+def walker_version(path: str) -> tuple[int, int, int] | None:
+    """`logan-walker --version` as a tuple, or None if it does not answer like the walker."""
+    try:
+        out = subprocess.run([path, "--version"], capture_output=True, text=True,
+                             timeout=30).stdout
+    except (OSError, subprocess.SubprocessError):
+        return None
+    m = re.search(r"\blogan-walker (\d+)\.(\d+)\.(\d+)", out)
+    return tuple(int(x) for x in m.groups()) if m else None
+
+
+def walker_version_problem(path: str) -> str | None:
+    """A message if `path` is a logan-walker outside the supported range, else None.
+
+    A binary that does not report a version (a test stub, a wrapper script) is let through.
+    """
+    if os.environ.get("DISASSEMBLER_ANY_WALKER"):
+        return None
+    v = walker_version(path)
+    if v is None or WALKER_MIN <= v < WALKER_BELOW:
+        return None
+    from disassembler import __version__
+    fmt = lambda t: ".".join(map(str, t))  # noqa: E731
+    return (f"{path} is logan-walker {fmt(v)}; disassembler {__version__} needs "
+            f"logan-walker >={fmt(WALKER_MIN)},<{fmt(WALKER_BELOW[:2])}. Update it, pass "
+            f"--walker-bin, or set DISASSEMBLER_ANY_WALKER=1 to run it anyway.")
+
+
