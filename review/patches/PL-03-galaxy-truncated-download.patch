+    def http_body(self, body, sent):
+        """A real http.client.HTTPResponse whose server declared len(body) and sent `sent`."""
+        import http.client
+        import io
+
+        class Sock:
+            def makefile(self, *a, **k):
+                return io.BufferedReader(io.BytesIO(
+                    b"HTTP/1.1 200 OK\r\nContent-Length: %d\r\n\r\n" % len(body) + body[:sent]))
+
+        resp = http.client.HTTPResponse(Sock())
+        resp.begin()
+        return resp
+
+    def test_a_download_cut_short_of_content_length_is_an_error(self):
+        # HTTPResponse.read1 returns b"" when the connection closes early, so the text
+        # wrapper saw a normal end of file: a partial cohort, status ok, exit 0.
+        body = TABLE.encode()
+        lms.get_galaxy_stream = lambda *a, **k: self.http_body(body, len(body) - 20)
+        rc, err = self.run_with_state("ok")
+        self.assertEqual(rc, 1, err)
+        self.assertIn("short of its Content-Length", err)
+        self.assertFalse((self.dir / "out" / "gene.summary.json").exists())
+
+    def test_a_complete_download_and_a_max_records_preview_pass(self):
+        body = TABLE.encode()
+        lms.get_galaxy_stream = lambda *a, **k: self.http_body(body, len(body))
+        rc, err = self.run_with_state("ok")
