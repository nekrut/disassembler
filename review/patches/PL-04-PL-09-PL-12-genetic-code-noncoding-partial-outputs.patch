+def codon_table_for(code_id: int) -> dict:
+    """Forward table of NCBI genetic code `code_id`, stops as '*'."""
+    if code_id == 11:
+        return CODON_TABLE_11
+    from Bio.Data.CodonTable import unambiguous_dna_by_id
+    t = unambiguous_dna_by_id[code_id]
+    table = dict(t.forward_table)
+    table.update({c: '*' for c in t.stop_codons})
+    return table
+
