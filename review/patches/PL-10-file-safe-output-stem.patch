+def file_safe_name(name: str, limit: int = 200) -> str:
+    """One path component from a FASTA record id, changed as little as possible: path
+    separators become '_', leading/trailing dots and spaces go (no '.', '..' or hidden
+    file), and the name is capped at `limit` bytes so the longest suffix stays under
+    NAME_MAX. Returns '' when nothing usable is left. Same rule as harvest.safe_target_name."""
+    name = name.replace("/", "_").replace("\\", "_").replace("\0", "_").strip(". ")
+    return name.encode()[:limit].decode(errors="ignore").rstrip(". ")
+
