+/* ================= LSH bucket table never fills (regression: 2^20 fixed table hung) ================= */
+static void test_pset_grows(void) {
+    pset_t p; pset_init(&p, 4, 2);                 /* 4 slots: the old code spun on the 5th key */
+    for (int i = 0; i < 1000; i++) bucket_add(&p, 0x9E3779B97F4A7C15ULL * (uint64_t)(i + 1), i);
+    CHECK(p.nbuk >= 2000, "table must grow to keep load <= 1/2 (nbuk=%llu)", (unsigned long long)p.nbuk);
+    int ok = 1;
+    for (int i = 0; i < 1000; i++) { bucket_t *b = bucket_find(&p, 0x9E3779B97F4A7C15ULL * (uint64_t)(i + 1));
+        if (!b || b->n != 1 || b->ids[0] != i) ok = 0; }
+    CHECK(ok, "every key survives the rehash with its id list");
+    CHECK(bucket_find(&p, 12345) == NULL, "absent key -> NULL (probe terminates)");
+    pset_free(&p);
+}
