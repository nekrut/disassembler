+def is_special(path: Path) -> bool:
+    """True if `path` is a symlink, or exists and is not a regular file: a device
+    (/dev/null), a pipe (a FIFO, a bash >(...)), /dev/stdout (a symlink). Those are written
+    into, never renamed over, and no temp file is put beside them."""
+    try:
+        return path.is_symlink() or not stat.S_ISREG(os.stat(path).st_mode)
+    except FileNotFoundError:
+        return False
+
+
+def publish(tmp: Path, dest: Path) -> None:
+    """Put a finished temp file in place: an atomic rename onto a regular file or a new
+    path; a copy into an existing special file, which a rename would replace (as root,
+    `--out-tree /dev/null` turned /dev/null into a regular file holding the tree)."""
+    if is_special(dest):
+        with open(tmp, "rb") as src, open(dest, "wb") as dst:
+            shutil.copyfileobj(src, dst)
+    else:
+        os.replace(tmp, dest)
+
