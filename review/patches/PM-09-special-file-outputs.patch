+    def _run_to(self, out_aln, out_tree):
+        ref, inp = self.work / "ref.fasta", self.work / "in.fasta"
+        _write(ref, [("gene", GENE)])
+        _write(inp, [("a", GENE), ("b", GENE)])
+        from disassembler.stage import stage_args
+        ns = stage_args(self.msa, ref=str(ref), input=str(inp), out_aln=str(out_aln),
+                        out_tree=str(out_tree), mafft_threads=1)
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            return self.msa.run(ns)
+
+    def test_a_fifo_output_is_written_into_not_replaced(self):
+        # os.replace() swapped a regular file in for the FIFO: the reader blocked forever
+        # and, as root, --out-tree /dev/null turned /dev/null into a regular file.
+        import stat
+        import threading
+        fifo = self.work / "tree.fifo"
+        os.mkfifo(fifo)
+        got = []
+        reader = threading.Thread(target=lambda: got.append(fifo.read_text()), daemon=True)
+        reader.start()
+        self.assertEqual(self._run_to(self.work / "aln.fasta", fifo), 0)
+        reader.join(10)
+        self.assertFalse(reader.is_alive(), "the FIFO's reader never got the tree")
+        self.assertTrue(stat.S_ISFIFO(os.lstat(fifo).st_mode))
+        self.assertEqual(got, ["(Reference);\n"])
+        self.assertEqual(sorted(p.name for p in self.work.glob(".tmp_*")), [])
+
+    def test_a_symlinked_output_keeps_its_link(self):
+        # /dev/stdout is a symlink; a rename replaced it with a regular file.
+        target = self.work / "real.fasta"
+        link = self.work / "link.fasta"
+        link.symlink_to(target)
+        self.assertEqual(self._run_to(link, self.work / "tree.nwk"), 0)
+        self.assertTrue(link.is_symlink())
+        self.assertEqual(target.read_text().count(">"), 3)
+        self.assertEqual((self.work / "tree.nwk").read_text(), "(Reference);\n")
+
