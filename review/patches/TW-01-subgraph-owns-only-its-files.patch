+impl Subgraph {
+    /// Give up ownership of the GFA so Drop leaves it on disk; returns its path.
+    pub fn keep(mut self) -> PathBuf {
+        self.owns_gfa = false;
+        self.gfa_path.clone()
+    }
 }
 
