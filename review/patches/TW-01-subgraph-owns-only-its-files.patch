+    fn dropping_a_hand_built_subgraph_leaves_its_path_alone() {
+        let p = std::env::temp_dir().join(format!("logan-owns-gfa-{}.gfa", std::process::id()));
+        std::fs::write(&p, b"keep").unwrap();
+        drop(Subgraph { accession: "A".into(), nodes: vec![], seqs: vec![], gfa_path: p.clone(), n_edges: 0, owns_gfa: false });
+        assert!(p.exists());
+        drop(Subgraph { accession: "A".into(), nodes: vec![], seqs: vec![], gfa_path: p.clone(), n_edges: 0, owns_gfa: true });
