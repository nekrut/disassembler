+/// The success path end to end under default flags: stitch, prune, prefer-majority, alts and
+/// every output writer, in input order with several workers.
+#[test]
+fn a_matching_accession_is_reconstructed() {
+    let fx = Fixture::matching("success", 3);
+    let out = fx.cmd_ga("ga_ok", "cache", &["-w", "3"]).output().unwrap();
+    let err = format!("{}{}", String::from_utf8_lossy(&out.stdout), String::from_utf8_lossy(&out.stderr));
+    assert_eq!(out.status.code(), Some(0), "{err}");
+    assert!(err.contains("3/3 accessions reconstructed"), "{err}");
+    let fasta = std::fs::read_to_string(fx.dir.join("out").join("r.fasta")).unwrap();
+    let recs: Vec<(&str, &str)> = fasta.split('>').skip(1)
+        .map(|r| { let (h, s) = r.split_once('\n').unwrap(); (h.split(' ').next().unwrap(), s.trim()) })
+        .collect();
+    let want: Vec<(String, &str)> = (0..3).map(|i| (format!("SRRFAKE{i}_primary"), QUERY)).collect();
+    assert_eq!(recs.iter().map(|(h, s)| (h.to_string(), *s)).collect::<Vec<_>>(), want, "{fasta}");
+    let summary = std::fs::read_to_string(fx.dir.join("out").join("q_walker_summary.json")).unwrap();
+    assert_eq!(summary.matches("\"status\": \"success\"").count(), 3, "{summary}");
+}
+
+#[test]
+fn fetch_only_counts_hits_and_misses() {
+    let fx = Fixture::new("fetchonly", 2);
+    let (code, err) = fx.code("cache", &["--fetch-only"]);
+    assert_eq!(code, 0, "{err}");
+    assert!(err.contains("2 fetched, 0 not available"), "{err}");
+    let (code, err) = fx.code("empty_cache", &["--fetch-only"]);
+    assert_ne!(code, 0, "a cache miss under --offline must not succeed: {err}");
+}
