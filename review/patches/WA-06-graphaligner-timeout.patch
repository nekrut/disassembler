 const PREFIX: &str = "logan-walker.";
 
+/// PIDs of the GraphAligner children now running; the signal thread stops them before it
+/// removes the directory they work in.
+pub static CHILDREN: std::sync::Mutex<Vec<u32>> = std::sync::Mutex::new(Vec::new());
+
+fn stop_children() {
+    let pids = CHILDREN.lock().map(|g| g.clone()).unwrap_or_default();
+    for pid in pids {
+        // SAFETY: kill has no memory-safety preconditions.
+        unsafe { libc::kill(pid as libc::pid_t, libc::SIGTERM) };
+    }
+}
