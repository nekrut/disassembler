+fn is_run_dir_name(name: &str) -> bool {
+    let Some((pid, suffix)) = name.strip_prefix(PREFIX).and_then(|rest| rest.split_once('.'))
+    else {
+        return false;
+    };
+    !pid.is_empty()
+        && pid.bytes().all(|b| b.is_ascii_digit())
+        && suffix.len() == 9
+        && suffix.bytes().all(|b| b.is_ascii_hexdigit())
+}
+
+/// Create `<dir>/.lock`, lock it, and only then write this kernel's identity into it. A
+/// sweeper ignores a lock file with no identity, so it cannot win the lock in the moment
+/// between our `open` and our `flock`. `None` (no `flock` on this filesystem, no identity)
+/// leaves a directory no sweep will ever remove, which is the safe side.
+#[cfg(unix)]
+fn hold_lock(dir: &Path) -> Option<std::fs::File> {
+    use std::io::Write;
+    use std::os::unix::io::AsRawFd;
+    let id = kernel_id()?;
+    let mut f = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(dir.join(LOCK_NAME))
+        .ok()?;
+    // SAFETY: flock on a descriptor this function owns.
+    if unsafe { libc::flock(f.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {
+        return None;
+    }
+    f.write_all(id.as_bytes()).ok()?;
+    Some(f)
+}
+
+#[cfg(not(unix))]
+fn hold_lock(_dir: &Path) -> Option<std::fs::File> {
+    None
+}
+
+/// Whether the run that made `dir` has ended: its lock file names this kernel and the lock
+/// is free. A missing or foreign lock file, a keep marker, or a lock that cannot be tested
+/// all mean "leave it".
+#[cfg(unix)]
+fn owner_is_gone(dir: &Path, me: &str) -> bool {
+    use std::os::unix::io::AsRawFd;
+    if dir.join(KEEP_NAME).exists() {
+        return false;
+    }
+    let lock = dir.join(LOCK_NAME);
+    match std::fs::read_to_string(&lock) {
+        Ok(id) if id == me => {}
+        _ => return false,
+    }
+    let Ok(f) = std::fs::File::open(&lock) else { return false };
+    // SAFETY: flock on a descriptor this function owns; closing `f` releases the lock.
+    unsafe { libc::flock(f.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) == 0 }
+}
+
+/// Names the kernel whose lock table a `flock` lives in. On Linux the boot id: the same in
+/// every container on a host, different on every other host and after a reboot. Elsewhere
+/// (macOS) the host name.
+#[cfg(unix)]
+fn kernel_id() -> Option<String> {
+    if let Ok(id) = std::fs::read_to_string("/proc/sys/kernel/random/boot_id") {
+        if !id.trim().is_empty() {
+            return Some(format!("boot {}", id.trim()));
+        }
+    }
+    let mut buf = [0u8; 256];
+    // SAFETY: `buf` is writable for `buf.len()` bytes.
+    if unsafe { libc::gethostname(buf.as_mut_ptr().cast(), buf.len()) } != 0 {
+        return None;
+    }
+    let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());
+    let host = String::from_utf8_lossy(&buf[..end]).into_owned();
+    (!host.is_empty()).then(|| format!("host {host}"))
 }
 
