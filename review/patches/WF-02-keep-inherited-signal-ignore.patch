+/// `nohup` sets SIGHUP to ignored so a run outlives its login session; the shell's hangup then
+/// reaches the whole job. 0.1.1 caught SIGHUP regardless, so the run ended on the hangup and
+/// GraphAligner, no longer inheriting the ignore, died with it. An ignored signal stays ignored.
+#[test]
+fn an_inherited_sighup_ignore_survives_a_hangup() {
+    use std::os::unix::process::CommandExt;
+    let fx = Fixture::matching("nohup", 1);
+    let base = fx.dir.join("scratch");
+    let base_arg = base.to_string_lossy().into_owned();
+    let mut cmd = fx.cmd_ga("ga_slow", "cache", &["--scratch-dir", &base_arg, "--allow-empty"]);
+    cmd.process_group(0).stdout(Stdio::null()).stderr(Stdio::null());
+    // SAFETY: signal() is async-signal-safe; between fork and exec, this is what nohup does.
+    unsafe {
+        cmd.pre_exec(|| {
+            libc::signal(libc::SIGHUP, libc::SIG_IGN);
+            Ok(())
+        });
+    }
+    let mut child = cmd.spawn().unwrap();
+    wait_for_scratch_file(&base);
+    // SAFETY: plain kill(2) on the child's process group, as the shell sends it to a job.
+    assert_eq!(unsafe { libc::kill(-(child.id() as i32), libc::SIGHUP) }, 0);
+    let status = wait_or_kill(&mut child, Duration::from_secs(60)).expect("walker hung");
+    assert_eq!(status.code(), Some(0), "the run must outlive an ignored SIGHUP: {status:?}");
+    let summary = std::fs::read_to_string(fx.dir.join("out").join("q_walker_summary.json")).unwrap();
+    assert!(!summary.contains("\"error\""), "GraphAligner must inherit the ignore: {summary}");
+}
