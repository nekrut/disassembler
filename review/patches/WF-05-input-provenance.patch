+fn sha256_hex(bytes: &[u8]) -> String {
+    use sha2::{Digest, Sha256};
+    Sha256::digest(bytes).iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn now_unix() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+/// The accession named in the first record's header, `>SRR8209082_0 ka:f:…` -> `SRR8209082`.
+/// Decodes only the first few KB.
+fn first_record_accession(compressed: &[u8]) -> Option<String> {
+    let mut dec = zstd::stream::read::Decoder::with_buffer(std::io::Cursor::new(compressed)).ok()?;
+    let mut buf = vec![0u8; 4096];
+    let mut n = 0;
+    while n < buf.len() {
+        match dec.read(&mut buf[n..]) {
+            Ok(0) => break,
+            Ok(k) => n += k,
+            Err(_) => return None,
+        }
+        if buf[..n].contains(&b'\n') {
+            break;
+        }
+    }
+    let line = buf[..n].split(|&b| b == b'\n').next()?;
+    let name = line.strip_prefix(b">")?.split(|b| b.is_ascii_whitespace()).next()?;
+    let p = name.iter().rposition(|&b| b == b'_')?;
+    Some(String::from_utf8_lossy(&name[..p]).into_owned())
+}
+
+/// Sidecar next to a cache entry: what the walker downloaded, as `key\tvalue` lines.
+fn meta_path(dir: &Path, accession: &str) -> PathBuf {
+    dir.join(format!("{accession}.unitigs.fa.zst.meta"))
+}
+
+fn read_cache_meta(cache_file: &Path) -> std::collections::HashMap<String, String> {
+    let mut p = cache_file.as_os_str().to_owned();
+    p.push(".meta");
+    std::fs::read_to_string(PathBuf::from(p))
+        .unwrap_or_default()
+        .lines()
+        .filter_map(|l| l.split_once('\t'))
+        .map(|(k, v)| (k.to_string(), v.to_string()))
+        .collect()
+}
+
+fn write_cache_meta(dir: &Path, accession: &str, i: &InputProvenance) -> std::io::Result<()> {
+    let mut text = format!("url\t{}\nbytes\t{}\nsha256\t{}\n", i.location, i.bytes, i.sha256);
+    if let Some(v) = &i.etag {
+        text.push_str(&format!("etag\t{v}\n"));
+    }
+    if let Some(v) = &i.last_modified {
+        text.push_str(&format!("last_modified\t{v}\n"));
+    }
+    if let Some(v) = i.fetched_at {
+        text.push_str(&format!("fetched_at\t{v}\n"));
+    }
+    let tmp = dir.join(format!(".{accession}.meta.{}.tmp", std::process::id()));
+    std::fs::write(&tmp, text)?;
+    std::fs::rename(&tmp, meta_path(dir, accession))
+}
