+/// Check before any download that `dir` can take cache entries, so a read-only, foreign or
+/// mistyped cache directory fails the run at once instead of after every transfer.
+pub fn probe_cache_dir(dir: &Path) -> Result<()> {
+    std::fs::create_dir_all(dir).map_err(crate::error::file_err("create cache directory", dir))?;
+    let probe = dir.join(format!(".probe.{}.tmp", std::process::id()));
+    std::fs::write(&probe, b"").map_err(crate::error::file_err("write into cache directory", dir))?;
+    let _ = std::fs::remove_file(&probe);
+    Ok(())
+}
