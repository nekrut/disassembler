+#[cfg(test)]
+mod store_tests {
+    use super::*;
+    use crate::config::Config;
+
+    /// A cache path that cannot be created even by root: its parent is a regular file.
+    fn unwritable_cache(tag: &str) -> PathBuf {
+        let blocker = std::env::temp_dir().join(format!("logan-walker-store-{tag}-{}", std::process::id()));
+        std::fs::write(&blocker, b"x").unwrap();
+        blocker.join("cache")
+    }
+
+    fn fetched() -> FetchedUnitigs {
+        FetchedUnitigs { index: 0, accession: "X".into(), compressed: vec![1, 2, 3], compressed_len: 3, fetch_secs: 0.0 }
+    }
+
+    #[test]
+    fn fetch_only_fails_an_accession_whose_cache_write_failed() {
+        let dir = unwritable_cache("product");
+        let f = Fetcher::new(&Config { unitigs_cache: Some(dir.clone()), fetch_only: true, ..Config::default() });
+        match f.store(&"X".to_string(), fetched()) {
+            Err(Error::CacheWrite { path, .. }) => assert_eq!(path, cache_path(&dir, "X")),
+            Err(e) => panic!("wrong error: {e}"),
+            Ok(_) => panic!("a failed cache write was reported as cached"),
+        }
+        assert!(probe_cache_dir(&dir).is_err(), "the up-front probe must refuse it too");
+        let _ = std::fs::remove_file(dir.parent().unwrap());
+    }
+
+    #[test]
+    fn an_analysis_run_keeps_the_bytes_when_the_cache_write_fails() {
+        let dir = unwritable_cache("analysis");
+        let f = Fetcher::new(&Config { unitigs_cache: Some(dir.clone()), ..Config::default() });
+        assert_eq!(f.store(&"X".to_string(), fetched()).expect("bytes kept").compressed_len, 3);
+        let _ = std::fs::remove_file(dir.parent().unwrap());
+    }
+}
