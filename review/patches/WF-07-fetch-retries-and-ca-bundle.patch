     #[test]
+    fn throttling_is_transient_and_honours_retry_after() {
+        for (code, ra) in [("429 Too Many Requests", Some(7)), ("408 Request Timeout", None)] {
+            let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+            let port = listener.local_addr().unwrap().port();
+            let head = match ra {
+                Some(s) => format!("HTTP/1.1 {code}\r\nRetry-After: {s}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"),
+                None => format!("HTTP/1.1 {code}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"),
+            };
+            std::thread::spawn(move || {
+                let (mut sock, _) = listener.accept().unwrap();
+                let mut reader = BufReader::new(sock.try_clone().unwrap());
+                let mut line = String::new();
+                while reader.read_line(&mut line).unwrap_or(0) > 0 && line != "\r\n" {
+                    line.clear();
+                }
+                let _ = sock.write_all(head.as_bytes());
+            });
+            let url = format!("http://127.0.0.1:{port}/u/X/X.unitigs.fa.zst");
+            match fetcher(10).try_once(0, &"X".to_string(), &url) {
+                Err(FetchAttempt::Transient(_, got)) => {
+                    assert_eq!(got, ra.map(Duration::from_secs), "{code}")
+                }
+                _ => panic!("{code} not retried"),
+            }
+        }
+    }
