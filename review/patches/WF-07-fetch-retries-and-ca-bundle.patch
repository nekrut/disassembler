+/// Exponential backoff with +/-50% jitter: about 1, 2, 4, 8, 16 s ... capped at 60 s.
+fn backoff(attempt: u32) -> Duration {
+    let base = 1000u64.saturating_mul(1 << attempt.saturating_sub(1).min(6)).min(60_000);
+    let ns = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.subsec_nanos() as u64)
+        .unwrap_or(0);
+    Duration::from_millis(base / 2 + ns % base.max(1))
+}
+
+/// Trust the PEM bundle named by SSL_CERT_FILE when set (as curl, OpenSSL and Python do);
+/// otherwise the compiled-in Mozilla roots.
+fn tls_config() -> ureq::tls::TlsConfig {
+    use ureq::tls::{parse_pem, PemItem, RootCerts, TlsConfig};
+    let roots = std::env::var_os("SSL_CERT_FILE")
+        .and_then(|p| std::fs::read(p).ok())
+        .map(|pem| {
+            parse_pem(&pem)
+                .filter_map(|i| match i {
+                    Ok(PemItem::Certificate(c)) => Some(c),
+                    _ => None,
+                })
+                .collect::<Vec<_>>()
+        })
+        .filter(|certs| !certs.is_empty())
+        .map(|certs| RootCerts::new_with_certs(&certs))
+        .unwrap_or(RootCerts::WebPki);
+    TlsConfig::builder().root_certs(roots).build()
+}
