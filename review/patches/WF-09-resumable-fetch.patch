+#[cfg(test)]
+mod v088_probe {
+    use super::*;
+    use crate::config::Config;
+    use std::io::{BufRead, BufReader, Write};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::sync::Arc;
+
+    /// Serves a 1,000,000-byte object at a steady 250 KB/s to every connection. Honours
+    /// `Range: bytes=N-` with a 206 when `ranges` is set. Counts bytes written.
+    fn serve(served: Arc<AtomicUsize>, conns: Arc<AtomicUsize>, ranges: bool) -> String {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        std::thread::spawn(move || {
+            for sock in listener.incoming() {
+                let mut sock = sock.unwrap();
+                let (served, conns) = (served.clone(), conns.clone());
+                std::thread::spawn(move || {
+                    conns.fetch_add(1, Ordering::SeqCst);
+                    let mut reader = BufReader::new(sock.try_clone().unwrap());
+                    let mut line = String::new();
+                    let mut start = 0usize;
+                    let mut is_head = false;
+                    loop {
+                        line.clear();
+                        if reader.read_line(&mut line).unwrap_or(0) == 0 || line == "\r\n" { break; }
+                        if line.starts_with("HEAD ") { is_head = true; }
+                        let l = line.to_ascii_lowercase();
+                        if ranges && l.starts_with("range: bytes=") {
+                            start = l[13..].trim().trim_end_matches('-').parse().unwrap();
+                        }
+                    }
+                    const TOTAL: usize = 1_000_000;
+                    let head = if start > 0 {
+                        format!("HTTP/1.1 206 Partial Content\r\nContent-Length: {}\r\nContent-Range: bytes {}-{}/{}\r\nETag: \"abc\"\r\nConnection: close\r\n\r\n", TOTAL - start, start, TOTAL - 1, TOTAL)
+                    } else {
+                        format!("HTTP/1.1 200 OK\r\nContent-Length: {TOTAL}\r\nETag: \"abc\"\r\nAccept-Ranges: bytes\r\nConnection: close\r\n\r\n")
+                    };
+                    if sock.write_all(head.as_bytes()).is_err() || is_head { return; }
+                    let mut sent = start;
+                    while sent < TOTAL {
+                        let n = 25_000.min(TOTAL - sent);
+                        if sock.write_all(&vec![b'A'; n]).is_err() { return; }
+                        served.fetch_add(n, Ordering::SeqCst);
+                        sent += n;
+                        std::thread::sleep(std::time::Duration::from_millis(100));
+                    }
+                });
+            }
+        });
+        format!("http://127.0.0.1:{port}/u/X/X.unitigs.fa.zst")
+    }
+
+    fn run(ranges: bool) {
+        let served = Arc::new(AtomicUsize::new(0));
+        let conns = Arc::new(AtomicUsize::new(0));
+        let url = serve(served.clone(), conns.clone(), ranges);
+        std::env::set_var("V088_URL", &url);
+        // 1 MB at 250 KB/s needs ~4 s; give a 1.5 s budget (the 900 s default, scaled down).
+        let f = Fetcher::new(&Config { fetch_timeout_secs: 1, ..Config::default() });
+        let t = std::time::Instant::now();
+        let r = f.fetch(0, &"X".to_string());
+        eprintln!("V088_PROBE ranges={ranges}: {:.1}s, {} connections, {} bytes served for a 1000000-byte object -> {}",
+            t.elapsed().as_secs_f64(), conns.load(Ordering::SeqCst), served.load(Ordering::SeqCst),
+            match r { Ok(x) => format!("OK {} bytes, all 'A': {}", x.compressed_len, x.compressed.iter().all(|&b| b == b'A')), Err(e) => format!("ERR {e}") });
+    }
+
+    #[test]
+    fn v088_steady_slow_transfer() { run(false); }
+    #[test]
+    fn v088_steady_slow_transfer_range_server() { run(true); }
+}
