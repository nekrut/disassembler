+#[cfg(test)]
+mod v112_probe {
+    use super::*;
+    use std::io::{Read as _, Write as _};
+    use std::net::TcpListener;
+
+    /// One-shot HTTP server: answers every connection with `resp`, `n` times.
+    fn serve(resp: Vec<u8>, n: usize) -> u16 {
+        let l = TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = l.local_addr().unwrap().port();
+        std::thread::spawn(move || {
+            for _ in 0..n {
+                let (mut s, _) = match l.accept() { Ok(x) => x, Err(_) => return };
+                let mut buf = [0u8; 4096];
+                let mut got = Vec::new();
+                while !got.windows(4).any(|w| w == b"\r\n\r\n") {
+                    let k = s.read(&mut buf).unwrap_or(0);
+                    if k == 0 { break; }
+                    got.extend_from_slice(&buf[..k]);
+                }
+                eprintln!("server {port} got: {}", String::from_utf8_lossy(&got).lines().next().unwrap_or(""));
+                let _ = s.write_all(&resp);
+            }
+        });
+        port
+    }
+
+    #[test]
+    fn v112_redirect_is_not_followed() {
+        let b = serve(b"HTTP/1.1 200 OK\r\nContent-Length: 4\r\nConnection: close\r\n\r\n(\xb5/\xfd".to_vec(), 1);
+        let redir = format!("HTTP/1.1 302 Found\r\nLocation: http://localhost:{b}/elsewhere\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").into_bytes();
+        let a = serve(redir, 3);
+        let f = Fetcher::new(&Config { fetch_attempts: 1, ..Config::default() });
+        match f.try_once(0, &"SRR1".to_string(), &format!("http://127.0.0.1:{a}/u/SRR1/SRR1.unitigs.fa.zst")) {
+            Err(FetchAttempt::Permanent(d)) => { eprintln!("V112 FIXED: Permanent {d}"); assert!(d.contains("redirect")) }
+            Ok(_) => panic!("redirect followed"),
+            Err(_) => panic!("wrong class"),
+        }
+    }
+
+    #[test]
