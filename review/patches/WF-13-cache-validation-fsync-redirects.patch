+    /// Network: a bad cache entry is replaced when online.
+    #[test]
+    #[ignore]
+    fn v112_bad_cache_entry_online_self_heals() {
+        let dir = std::env::temp_dir().join(format!("v112-heal-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(cache_path(&dir, "SRR8209082"), b"<html>x</html>").unwrap();
+        let f = Fetcher::new(&Config { unitigs_cache: Some(dir.clone()), offline: false, ..Config::default() });
+        let got = f.fetch(0, &"SRR8209082".to_string()).expect("refetched");
+        eprintln!("V112 HEALED: {} bytes; cache now {} bytes", got.compressed_len, std::fs::metadata(cache_path(&dir, "SRR8209082")).unwrap().len());
+        assert_eq!(got.compressed_len, 1861058);
+        std::fs::remove_dir_all(&dir).ok();
+    }
