+        match f.try_once(0, &"SRR1".to_string(), &format!("http://127.0.0.1:{a}/x")) {
+            Err(FetchAttempt::Transient(d)) => { eprintln!("V112 FIXED: Transient {d}"); assert!(d.contains("not a zstd")) }
+            _ => panic!("html accepted"),
+        }
+    }
