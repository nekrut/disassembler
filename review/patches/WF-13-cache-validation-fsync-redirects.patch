+    #[test]
+    fn v112_stale_tempfiles_are_swept() {
+        let dir = std::env::temp_dir().join(format!("v112-sweep-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let old = dir.join(".SRR1.123.456.tmp");
+        let new = dir.join(".SRR2.123.789.tmp");
+        let other = dir.join(".notes.tmp");
+        for p in [&old, &new, &other] { std::fs::write(p, b"x").unwrap(); }
+        let f = std::fs::File::options().write(true).open(&old).unwrap();
+        f.set_modified(std::time::SystemTime::now() - Duration::from_secs(2 * 24 * 3600)).unwrap();
+        let other_f = std::fs::File::options().write(true).open(&other).unwrap();
+        other_f.set_modified(std::time::SystemTime::now() - Duration::from_secs(2 * 24 * 3600)).unwrap();
+        let _ = Fetcher::new(&Config { unitigs_cache: Some(dir.clone()), ..Config::default() });
+        assert!(!old.exists() && new.exists() && other.exists());
+        std::fs::remove_dir_all(&dir).ok();
+    }
