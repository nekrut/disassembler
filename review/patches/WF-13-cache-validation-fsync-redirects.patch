+/// zstd frame magic (28 b5 2f fd) or a skippable frame (0x184D2A50..=0x184D2A5F, LE).
+fn looks_like_zstd(b: &[u8]) -> bool {
+    if b.len() < 4 {
+        return false;
+    }
+    let m = u32::from_le_bytes([b[0], b[1], b[2], b[3]]);
+    m == 0xFD2F_B528 || (m & 0xFFFF_FFF0) == 0x184D_2A50
+}
+
+/// Remove `.<ACC>.<pid>.<ns>.tmp` files left by a writer killed between write and rename.
+/// Only files older than a day: a live writer on this or another host finishes in minutes.
+fn sweep_stale_tempfiles(dir: &Path) {
+    let Ok(rd) = std::fs::read_dir(dir) else { return };
+    let day = Duration::from_secs(24 * 3600);
+    for e in rd.flatten() {
+        let name = e.file_name();
+        let name = name.to_string_lossy();
+        // Exactly the shape write_cache_atomic makes: .<ACC>.<pid>.<ns>.tmp
+        let parts: Vec<&str> = name.split('.').collect();
+        let ours = parts.len() == 5
+            && parts[0].is_empty()
+            && parts[4] == "tmp"
+            && parts[2].bytes().all(|c| c.is_ascii_digit())
+            && parts[3].bytes().all(|c| c.is_ascii_digit());
+        if !ours {
+            continue;
+        }
+        let old = e
+            .metadata()
+            .and_then(|m| m.modified())
+            .ok()
+            .and_then(|t| t.elapsed().ok())
+            .is_some_and(|a| a > day);
+        if old {
+            let _ = std::fs::remove_file(e.path());
+        }
+    }
+}
