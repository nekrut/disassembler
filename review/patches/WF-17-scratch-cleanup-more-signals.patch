@@ -95,11 +104,28 @@ impl Drop for Scratch {
     }
 }
 
+/// Whether `sig` was inherited as SIG_IGN.
+#[cfg(unix)]
+fn ignored_at_start(sig: i32) -> bool {
+    // SAFETY: a null `act` only reads the current disposition.
+    unsafe {
+        let mut old: libc::sigaction = std::mem::zeroed();
+        libc::sigaction(sig, std::ptr::null(), &mut old) == 0 && old.sa_sigaction == libc::SIG_IGN
+    }
+}
+
 /// `remove_dir_all`, tried twice: a worker can create a file in the directory while it is
 /// being emptied, which makes the first attempt fail with "directory not empty".
 fn remove(path: &Path) {
-    if std::fs::remove_dir_all(path).is_err() {
-        let _ = std::fs::remove_dir_all(path);
+    // Rename first: a worker still running keeps writing to the old name and gets ENOENT
+    // instead of refilling the directory while it is being emptied. The new name keeps the
+    // `logan-walker.<pid>.` prefix, so the next run's sweep still finds it.
+    let mut dying = path.as_os_str().to_owned();
+    dying.push(".dying");
+    let dying = PathBuf::from(dying);
+    let target = if std::fs::rename(path, &dying).is_ok() { dying.as_path() } else { path };
+    if std::fs::remove_dir_all(target).is_err() {
+        let _ = std::fs::remove_dir_all(target);
     }
 }
 
