+/// Route unitigs below `floor` that are NOT error branches: no sibling at the fork into or
+/// out of them clears the floor, so removing them would cut the gene rather than an error.
+pub fn protected_route_nodes(
+    graph: &UnitigGraph,
+    steps: &[PathStep],
+    floor: f32,
+) -> std::collections::HashSet<UnitigId> {
+    use crate::types::Orient;
+    let fwd = |s: &PathStep| matches!(s.orient, Orient::Forward);
+    // deeper sibling leaving `from` (oriented) other than `skip`
+    let deeper = |from: UnitigId, from_fwd: bool, skip: UnitigId| {
+        graph.edges(from).iter().any(|&e| {
+            let (t, sf, _) = parse::unpack_edge(e);
+            sf == from_fwd && t != skip && graph.abundance[t as usize] >= floor
+        })
+    };
+    let mut keep = std::collections::HashSet::new();
+    for (i, s) in steps.iter().enumerate() {
+        if graph.abundance[s.node as usize] >= floor {
+            continue;
+        }
+        let mut error_branch = false;
+        if i > 0 {
+            let p = &steps[i - 1];
+            error_branch |= deeper(p.node, fwd(p), s.node);
+        }
+        if i + 1 < steps.len() {
+            let n = &steps[i + 1];
+            // into n = out of n reversed
+            error_branch |= deeper(n.node, !fwd(n), s.node);
+        }
+        if !error_branch {
+            keep.insert(s.node);
+        }
+    }
+    keep
 }
 
