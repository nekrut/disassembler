 ///
 /// Median rather than mean, so one repeat-collapsed unitig cannot drag it.
 pub fn path_depth(graph: &UnitigGraph, steps: &[PathStep]) -> f32 {
-    let mut ab: Vec<f32> = steps.iter().map(|s| graph.abundance[s.node as usize]).collect();
+    // k-mer-weighted median: a unitig counts once per k-mer it holds, so short error
+    // unitigs on the route cannot outvote the long ones that carry the gene.
+    let mut ab: Vec<(f32, u64)> = steps
+        .iter()
+        .map(|s| {
+            let w = graph.seq_len(s.node).saturating_sub(30).max(1) as u64;
+            (graph.abundance[s.node as usize], w)
+        })
+        .collect();
     if ab.is_empty() {
         return 0.0;
     }
-    ab.sort_by(|x, y| x.partial_cmp(y).unwrap_or(std::cmp::Ordering::Equal));
-    ab[ab.len() / 2]
+    ab.sort_by(|x, y| x.0.partial_cmp(&y.0).unwrap_or(std::cmp::Ordering::Equal));
+    let total: u64 = ab.iter().map(|x| x.1).sum();
+    let mut acc = 0u64;
+    for &(a, w) in &ab {
+        acc += w;
+        if acc * 2 > total {
+            return a;
+        }
+    }
+    ab[ab.len() - 1].0
+}
