+/// Group the references of a multi-anchor pool by shared canonical k-mers.
+///
+/// Two references are linked when the k-mers they share are at least `min_frac` of the
+/// smaller one's distinct k-mers; groups are the connected components. Multi-anchor mode
+/// keeps one primary per accession across the whole pool, so more than one group means
+/// the pool probably holds different genes and all but one will be dropped.
+pub fn reference_groups(k: usize, queries: &[Query], min_frac: f64) -> Vec<Vec<usize>> {
+    let mask = if k >= 32 { u64::MAX } else { (1u64 << (2 * k)) - 1 };
+    let shift = 2 * (k as u64 - 1);
+    let sets: Vec<std::collections::HashSet<u64>> = queries
+        .iter()
+        .map(|q| {
+            let mut s = std::collections::HashSet::new();
+            let (mut fwd, mut rev, mut run) = (0u64, 0u64, 0usize);
+            for &b in &q.seq {
+                match base_code(b) {
+                    Some(c) => {
+                        fwd = ((fwd << 2) | c) & mask;
+                        rev = (rev >> 2) | ((3 - c) << shift);
+                        run += 1;
+                    }
+                    None => (fwd, rev, run) = (0, 0, 0),
+                }
+                if run >= k {
+                    s.insert(fwd.min(rev));
+                }
+            }
+            s
+        })
+        .collect();
+    let mut parent: Vec<usize> = (0..queries.len()).collect();
+    fn root(p: &mut [usize], mut x: usize) -> usize {
+        while p[x] != x {
+            p[x] = p[p[x]];
+            x = p[x];
+        }
+        x
+    }
+    for i in 0..sets.len() {
+        for j in i + 1..sets.len() {
+            let small = sets[i].len().min(sets[j].len());
+            if small == 0 {
+                continue;
+            }
+            let (a, b) = if sets[i].len() <= sets[j].len() { (i, j) } else { (j, i) };
+            let shared = sets[a].iter().filter(|x| sets[b].contains(x)).count();
+            if shared as f64 >= min_frac * small as f64 {
+                let (ri, rj) = (root(&mut parent, i), root(&mut parent, j));
+                parent[ri] = rj;
+            }
+        }
+    }
+    let mut groups: std::collections::BTreeMap<usize, Vec<usize>> = Default::default();
+    for i in 0..queries.len() {
+        let r = root(&mut parent, i);
+        groups.entry(r).or_default().push(i);
+    }
+    let mut out: Vec<Vec<usize>> = groups.into_values().collect();
+    out.sort_by_key(|g| g[0]);
+    out
+}
