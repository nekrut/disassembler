+/// PIDs of running GraphAligner children, so a signal can stop them before the directory
+/// they write into is removed.
+static CHILDREN: std::sync::Mutex<Vec<u32>> = std::sync::Mutex::new(Vec::new());
+
+pub fn track_child(pid: u32) {
+    if let Ok(mut c) = CHILDREN.lock() {
+        c.push(pid);
+    }
+}
+
+pub fn untrack_child(pid: u32) {
+    if let Ok(mut c) = CHILDREN.lock() {
+        c.retain(|&p| p != pid);
+    }
+}
+
+fn terminate_children() {
+    // try_lock: never block the signal thread behind a worker.
+    if let Ok(c) = CHILDREN.try_lock() {
+        for &pid in c.iter() {
+            // SAFETY: kill has no memory-safety preconditions.
+            #[cfg(unix)]
+            unsafe {
+                libc::kill(pid as libc::pid_t, libc::SIGTERM);
+            }
+        }
+    }
+}
