+/// `println!` for progress lines. On a closed stdout the write raises SIGPIPE, which the
+/// signal thread in scratch.rs turns into "stop aligners, remove scratch, die by SIGPIPE";
+/// this thread only has to wait for it rather than panic with a backtrace.
+macro_rules! println {
+    ($($t:tt)*) => {{
+        use std::io::Write as _;
+        if let Err(e) = writeln!(std::io::stdout(), $($t)*) {
+            if e.kind() == std::io::ErrorKind::BrokenPipe {
+                std::thread::sleep(std::time::Duration::from_secs(10));
+                std::process::exit(128 + 13);
+            }
+            panic!("failed printing to stdout: {e}");
+        }
+    }};
+}
