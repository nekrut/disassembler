+/// A finite number in `[lo, hi]`. `f64::from_str` takes "nan" and "inf", which disabled
+/// a gate (`cov < NaN` is false) and wrote NaN/inf into the run summary's JSON.
+fn number_in(flag: &str, raw: &str, lo: f64, hi: f64) -> error::Result<f64> {
+    let v: f64 = raw
+        .parse()
+        .map_err(|_| error::Error::Usage(format!("{flag} needs a number, got {raw:?}")))?;
+    if !v.is_finite() || v < lo || v > hi {
+        let range = if hi >= f32::MAX as f64 { format!(">= {lo}") } else { format!("in [{lo}, {hi}]") };
+        return Err(error::Error::Usage(format!("{flag} must be {range}, got {raw}")));
+    }
+    Ok(v)
+}
