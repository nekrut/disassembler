+
+/// The default-on majority correction, through the binary, on the shape every real GAF row
+/// has: the alignment starts and ends inside a unitig (`path_start` 10, `path_end` 130 of a
+/// 140 nt path). One site, 60% against 40%, and the aligner hands back the 40% route because
+/// it is the one that matches the reference.
+#[test]
+fn the_majority_allele_reaches_the_primary_when_the_gene_has_flanks() {
+    use std::os::unix::fs::PermissionsExt;
+    let dir = std::env::temp_dir().join(format!("logan-walker-cli-{}-majority", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(dir.join("cache")).unwrap();
+
+    let (left, right) = ("TTGACCATGA", "CGGATTACTG");
+    let gene = "ATGGCTGCTAAAGAAGGCGTTCTGGAAATCGGTCAGTGGATCAAAGAGCTGCTGAAAGGCACCGTTGATCTGCGTAACCC\
+                GGAAGTGCTGTTTACCGATCACAGCTGGATTCAGGGCTAA";
+    assert_eq!(gene.len(), 120);
+    let full = format!("{left}{gene}{right}");
+    let site = left.len() + 60; // 0-based offset of the two-allele site in `full`
+    let other = if full.as_bytes()[site] == b'A' { "C" } else { "A" };
+    let minor = &full[site - 30..site + 31]; // k = 31: 30 + the site + 30
+    let major = format!("{}{other}{}", &full[site - 30..site], &full[site + 1..site + 31]);
+    let unitigs = format!(
+        ">SRRMAJ_0 ka:f:100.0   L:+:1:+  L:+:2:+\n{}\n\
+         >SRRMAJ_1 ka:f:40.0   L:-:0:-  L:+:3:+\n{minor}\n\
+         >SRRMAJ_2 ka:f:60.0   L:-:0:-  L:+:3:+\n{major}\n\
+         >SRRMAJ_3 ka:f:100.0   L:-:1:-  L:-:2:-\n{}\n",
+        &full[..site], &full[site + 1..]
+    );
+    std::fs::write(dir.join("cache").join("SRRMAJ.unitigs.fa.zst"),
+                   zstd::encode_all(unitigs.as_bytes(), 3).unwrap()).unwrap();
+    std::fs::write(dir.join("accs.txt"), "SRRMAJ\n").unwrap();
+    std::fs::write(dir.join("q.fasta"), format!(">gene\n{gene}\n")).unwrap();
+    // The row GraphAligner would write: the reference-matching route >0>1>3, 140 nt, with the
+    // gene at 10..130 of it.
+    let ga = dir.join("ga");
+    std::fs::write(&ga,
+        "#!/bin/sh\n[ \"$1\" = --version ] && { echo 'GraphAligner bioconda 1.0.17b-'; exit 0; }\n\
+         while [ $# -gt 0 ]; do case \"$1\" in -a) gaf=\"$2\"; shift 2;; *) shift;; esac; done\n\
+         printf 'gene\\t120\\t0\\t120\\t+\\t>0>1>3\\t140\\t10\\t130\\t120\\t120\\t60\\n' > \"$gaf\"\n").unwrap();
+    std::fs::set_permissions(&ga, std::fs::Permissions::from_mode(0o755)).unwrap();
+
+    let run = |out: &str, extra: &[&str]| -> (String, String) {
+        let o = Command::new(BIN)
+            .arg("--graphaligner").arg(&ga)
+            .arg("-l").arg(dir.join("accs.txt"))
+            .arg("-q").arg(dir.join("q.fasta"))
+            .arg("--unitigs-cache").arg(dir.join("cache")).arg("--offline")
+            .arg("-o").arg(dir.join(out))
+            .arg("-f").arg(dir.join(out).join("r.fasta"))
+            .args(extra)
+            .output().unwrap();
+        let err = String::from_utf8_lossy(&o.stderr).into_owned();
+        assert_eq!(o.status.code(), Some(0), "{err}");
+        let fa = std::fs::read_to_string(dir.join(out).join("r.fasta")).unwrap();
+        let seq: String = fa.lines().filter(|l| !l.starts_with('>')).collect();
+        (seq, err)
+    };
+
+    let (kept, _) = run("off", &["--no-prefer-majority"]);
+    assert_eq!(kept, gene, "switched off, the primary stays on the reference-matching 40% allele");
+
+    let (seq, err) = run("on", &[]);
+    let want = format!("{}{other}{}", &gene[..60], &gene[61..]);
+    assert_eq!(seq, want, "by default the primary must carry the 60% allele\n{err}");
+    assert!(err.contains("consensus: 1 site(s)"), "{err}");
+    let alts = std::fs::read_to_string(dir.join("on").join("alt_haplotypes.fasta")).unwrap();
+    assert!(alts.contains(" vaf=0.400 ") && !alts.contains(" vaf=0.600 "),
+            "the alternative left over must be the minority allele: {alts}");
+    let _ = std::fs::remove_dir_all(&dir);
+}
