+    #[test]
+    fn the_majority_swap_works_when_the_window_is_inside_the_path() {
+        let g = diamond(40.0, 60.0);
+        let s = subgraph_of(&g);
+        let p = GafPath { path_start: 1, path_end: 5, ..walked() };
+        let query = q("CGTA");
+        let before = stitch::stitch(&maj(true), &g, &p, &s, &query).unwrap().unwrap();
+        assert_eq!(before.seq, b"CGTA", "stitched[1..5] of ACGTAG");
+        let fixed = prefer_majority(&maj(true), &g, &s, &p, &query)
+            .unwrap()
+            .expect("the 60% allele must replace the 40% one wherever the window sits");
+        let after = stitch::stitch(&maj(true), &g, &fixed, &s, &query).unwrap().unwrap();
+        assert_eq!(after.seq, b"CGTC");
+        assert_eq!((fixed.path_start, fixed.path_end), (1, 5), "a substitution moves nothing");
+    }
