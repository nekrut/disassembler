+    /// A fork with a branch at Logan's ka:f ceiling is not a clean frequency call: its AF is
+    /// a bound. The VCF must say so in FILTER and the long table in `ka_saturated`.
+    #[test]
+    fn a_saturated_fork_is_flagged_not_passed() {
+        let dir = std::env::temp_dir().join(format!("logan-vcf-sat-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        let q = [query(b"TTTATTT")];
+        let mut a = alt(b"TTTGTTT", 0.1071, 3000.0);
+        a.taken_abundance = crate::types::KA_CEILING;
+        a.ka_saturated = true;
+        let s = Summary { total: 1, success: 1, results: vec![result(b"TTTATTT", vec![a])] };
+        let sites = snv_sites_all(&s, &q);
+        write_vcfs(&s, &q, &dir, &sites).unwrap();
+        write_snv_table(&s, &q, &dir.join("snvs.tsv"), &sites).unwrap();
+        write_alts(&s, &dir.join("alts.fa")).unwrap();
+        let vcf = std::fs::read_to_string(dir.join("ACC.vcf")).unwrap();
+        let row = vcf.lines().find(|l| !l.starts_with('#')).unwrap();
+        assert_eq!(row.split('\t').nth(6), Some("KaSat"), "{row}");
+        assert!(vcf.contains("##FILTER=<ID=KaSat"), "{vcf}");
+        let tsv = std::fs::read_to_string(dir.join("snvs.tsv")).unwrap();
+        assert!(tsv.lines().next().unwrap().ends_with("\tka_saturated"), "{tsv}");
+        assert!(tsv.lines().nth(1).unwrap().ends_with("\t1"), "{tsv}");
+        assert!(std::fs::read_to_string(dir.join("alts.fa")).unwrap().contains(" ka_sat=1"));
+        std::fs::remove_dir_all(&dir).ok();
+    }
+
