+/// Coverage of the alleles at the fork after `walk[fork_index]`: the walked branch plus every
+/// other exit that rejoins the route within `max_detour`. An exit that heads elsewhere (a
+/// repeat, a paralog) is not an allele of this site and must not dilute its VAFs; `phase`
+/// applies the same rule through `in_bubble`.
+fn site_total(
+    out: &[Vec<Oriented>],
+    at: &HashMap<Oriented, usize>,
+    branches: &[Oriented],
+    taken: Oriented,
+    fork_index: usize,
+    max_detour: usize,
+    abund: impl Fn(Oriented) -> f32,
+) -> f64 {
+    branches
+        .iter()
+        .filter(|&&b| b == taken || rejoin(out, at, b, fork_index, max_detour).is_some())
+        .map(|&b| abund(b) as f64)
+        .sum()
+}
