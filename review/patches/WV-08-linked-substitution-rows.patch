+    /// An alt with two substitutions in one bubble yields two linked rows, not none.
+    #[test]
+    fn two_linked_substitutions_yield_two_rows() {
+        let primary = b"TTTATTTGTTT";
+        let q = query(primary);
+        let rows = snv_sites(&result(primary, vec![alt(b"TTTCTTTATTT", 0.25, 25.0)]), &q);
+        let got: Vec<(usize, u8)> = rows.iter().map(|r| (r.pos, r.alts[0].0)).collect();
+        assert_eq!(got, vec![(4, b'C'), (8, b'A')]);
+        assert!(rows.iter().all(|r| r.fork == 7 && r.alts[0].1 == 0.25));
+    }
