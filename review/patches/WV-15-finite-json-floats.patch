+/// A float option that must be a finite number in `[lo, hi]` (`hi` = None: no upper bound).
+/// `inf` and `NaN` parse as f64 but cannot be written to JSON and switch gates off silently.
+fn finite_in(flag: &str, raw: &str, lo: f64, hi: Option<f64>) -> error::Result<f64> {
+    let v: f64 = raw.parse().map_err(|e| error::Error::Usage(format!("{flag}: {e}")))?;
+    if !v.is_finite() || v < lo || hi.is_some_and(|h| v > h) {
+        let range = match hi { Some(h) => format!("[{lo}, {h}]"), None => format!(">= {lo}") };
+        return Err(error::Error::Usage(format!("{flag} must be a finite number {range}, got {raw:?}")));
+    }
+    Ok(v)
+}
