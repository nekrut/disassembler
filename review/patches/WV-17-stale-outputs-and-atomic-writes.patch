 use std::io::{BufWriter, Write};
-use std::path::Path;
+use std::path::{Path, PathBuf};
+
+/// Writes `<dst>.tmp.<pid>` and renames it over `dst` on `commit`, so a reader (or a rerun
+/// after a failure) never sees a truncated file under the final name.
+pub struct AtomicFile {
+    tmp: PathBuf,
+    dst: PathBuf,
+    w: Option<BufWriter<std::fs::File>>,
+}
+
+impl AtomicFile {
+    pub fn create(dst: &Path) -> Result<Self> {
+        let mut name = dst.file_name().unwrap_or_default().to_os_string();
+        name.push(format!(".tmp.{}", std::process::id()));
+        let tmp = dst.with_file_name(name);
+        let w = BufWriter::new(std::fs::File::create(&tmp)?);
+        Ok(AtomicFile { tmp, dst: dst.to_path_buf(), w: Some(w) })
+    }
+    pub fn commit(mut self) -> Result<()> {
+        let w = self.w.take().expect("not committed");
+        let f = w.into_inner().map_err(|e| e.into_error())?;
+        let done = f.sync_all().and_then(|_| std::fs::rename(&self.tmp, &self.dst));
+        if done.is_err() {
+            let _ = std::fs::remove_file(&self.tmp);
+        }
+        Ok(done?)
+    }
+}
+
+impl Write for AtomicFile {
+    fn write(&mut self, b: &[u8]) -> std::io::Result<usize> {
+        self.w.as_mut().expect("open").write(b)
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        self.w.as_mut().expect("open").flush()
+    }
+}
+
+impl Drop for AtomicFile {
+    fn drop(&mut self) {
+        if self.w.take().is_some() {
+            let _ = std::fs::remove_file(&self.tmp);
+        }
+    }
+}
+
+/// First bytes of every VCF this walker writes; only such files are ever deleted.
+pub const VCF_SIGNATURE: &[u8] = b"##fileformat=VCFv4.2\n##source=logan-walker";
+pub const SNV_TABLE_HEADER: &str = "gene\tpos\tref\talt\taccession\taf\tka_alt\tka_ref\tfork";
+
+/// Remove `path` only if it starts with `sig` (a file this walker wrote). Returns whether it did.
+pub fn remove_if_ours(path: &Path, sig: &[u8]) -> Result<bool> {
+    use std::io::Read;
+    let mut head = vec![0u8; sig.len()];
+    match std::fs::File::open(path) {
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(false),
+        Err(e) => return Err(e.into()),
+        Ok(mut f) => {
+            if f.read_exact(&mut head).is_err() || head != sig {
+                return Ok(false);
+            }
+        }
+    }
+    std::fs::remove_file(path)?;
+    Ok(true)
+}
 
