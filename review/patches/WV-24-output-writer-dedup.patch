 use std::io::{BufWriter, Write};
 use std::path::Path;
 
+/// Open `path` for writing, creating its parent directory first.
+fn create(path: &Path) -> Result<BufWriter<std::fs::File>> {
+    if let Some(parent) = path.parent() {
+        if !parent.as_os_str().is_empty() {
+            std::fs::create_dir_all(parent)?;
+        }
+    }
+    Ok(BufWriter::new(std::fs::File::create(path)?))
+}
+
+/// ` anchor={rid}` in multi-anchor mode, empty otherwise, so single-anchor headers stay
+/// byte-identical to the golden fixtures.
+fn anchor_suffix(h: &crate::types::Haplotype) -> String {
+    match &h.anchor_used {
+        Some(rid) => format!(" anchor={rid}"),
+        None => String::new(),
+    }
+}
+
+/// `, "key": v` or `, "key": null`.
+fn json_opt<T: std::fmt::Display>(w: &mut impl Write, key: &str, v: Option<T>) -> Result<()> {
+    match v {
+        Some(v) => write!(w, ", \"{key}\": {v}")?,
+        None => write!(w, ", \"{key}\": null")?,
+    }
+    Ok(())
+}
